# Discord Bot Token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# Discord Guild/Server ID (right-click server -> Copy Server ID, needs Developer Mode)
DISCORD_GUILD_ID=your_guild_id_here

# Fernet encryption key for passwords (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your_fernet_key_here

# Web Dashboard credentials
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=changeme

# Secret key for Flask sessions (generate a random string)
FLASK_SECRET_KEY=changeme_random_secret

# Port for the web dashboard
DASHBOARD_PORT=5000
